# Copy to .env for local development. Do NOT commit real values.

# MongoDB connection string (required at runtime).
MONGODB_URI=mongodb://localhost:27017

# Logical databases, kept separate on purpose.
B2B_DB_NAME=chatbucket_b2b
BLOG_DB_NAME=chatbucket
CONTEST_DB_NAME=ChatBucketHackathon

# Auth. Generate a strong secret in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=30

# Billing currency label (all rates are in INR).
CURRENCY=INR

# Stamped on each account at signup alongside the acceptance timestamp. Bump
# this when the Terms & Conditions text changes.
TERMS_VERSION=v1

# --- Credits / billing -------------------------------------------------------
# When true, POST /usage debits credits and returns 402 once they run out.
# Existing accounts start at zero, so they must be topped up before their
# metered calls will succeed. Set false to meter without ever blocking.
ENFORCE_CREDIT_BALANCE=true

# Credits granted to a new account. 0 means top up before the first API call.
SIGNUP_BONUS_CREDITS=0

# Shared secret the payment gateway's webhook presents to mark a top-up paid.
# Unset means NO request can grant credits (the confirm endpoint returns 503).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BILLING_WEBHOOK_SECRET=

# --- Razorpay ----------------------------------------------------------------
# Dashboard > Settings > API Keys. `rzp_test_` keys hit the sandbox.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks. A DIFFERENT value from the key secret —
# webhook signatures are computed with this one. Unset ⇒ the webhook 503s.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TIMEOUT_SECONDS=15

# Invoice numbering: INV-0001. Global, gap-free sequence — change the prefix
# only between accounting periods, never mid-sequence.
INVOICE_NUMBER_PREFIX=INV-
INVOICE_NUMBER_PADDING=4

# --- Service status ----------------------------------------------------------
# Required to write any status (heartbeats, manual changes). Unset = read-only.
STATUS_WEBHOOK_SECRET=
# A heartbeat/probe older than this reads `unknown` rather than staying green.
STATUS_STALE_AFTER_SECONDS=300
# Optional health URLs to poll: key=url pairs. Empty disables probing.
#   STATUS_PROBE_URLS=tts=https://tts.internal/health,stt=https://stt.internal/health
STATUS_PROBE_URLS=
STATUS_PROBE_INTERVAL_SECONDS=60

# --- Upstream vendors ---------------------------------------------------------
# Required to read GET /vendors/usage, which reports what our suppliers cost us
# and how much free credit is left. Operator-only: it is our margin, not the
# customer's data. Unset = the endpoint returns 503.
OPS_SECRET=
# Free-tier allowances, as vendor=amount in the VENDOR's own unit (Deepgram
# meters minutes, Murf characters). Ships empty on purpose: a guessed quota
# would render an authoritative-looking "credit remaining" that is fiction.
# Unset means burn is still counted, with `remaining` reported as null.
#   VENDOR_FREE_QUOTAS=deepgram=12000,murf=100000
VENDOR_FREE_QUOTAS=

# --- Rate limiting / sessions ------------------------------------------------
RATE_LIMIT_ENABLED=true
# Only enable behind a proxy you control — the header is trivially forged.
TRUST_PROXY_HEADERS=false
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:3000,https://chatbucket.chat,https://www.chatbucket.chat,https://chatbucket.business

# --- Email -----------------------------------------------------------------
# auto = SMTP when SMTP_HOST is set, otherwise log to the console (dev).
# Other values: smtp | console | disabled. In production, `auto` with no
# SMTP_HOST refuses to start rather than silently swallowing reset emails.
EMAIL_BACKEND=auto

# Any SMTP provider works — SendGrid, SES, Mailgun, Postmark, Gmail.
#   SendGrid: smtp.sendgrid.net, username literally "apikey", password = the key
#   SES:      email-smtp.<region>.amazonaws.com, SMTP credentials (not IAM keys)
#   Mailgun:  smtp.mailgun.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Port 587 uses STARTTLS (the defaults below). For implicit TLS on port 465,
# set SMTP_USE_SSL=true and SMTP_STARTTLS=false.
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15

# The From: header. Must be an address your provider has verified.
EMAIL_FROM=no-reply@chatbucket.chat
EMAIL_FROM_NAME=ChatBucket

# Where demo requests are emailed. Leave empty to skip that notification.
SALES_EMAIL=

# Used to build the password-reset link: APP_BASE_URL + PASSWORD_RESET_PATH.
APP_BASE_URL=http://localhost:3000
PASSWORD_RESET_PATH=/reset-password

ENVIRONMENT=development
